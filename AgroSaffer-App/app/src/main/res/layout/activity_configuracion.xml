<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">

        <!-- ================= CABECERA ================= -->
        <TextView
            style="@style/Agro.Texto.TituloPantalla"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ajustes" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Apariencia y umbrales del cultivo"
            android:textColor="@color/sp_tinta_suave"
            android:textSize="13sp" />

        <!-- ================= APARIENCIA ================= -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Agro.Tarjeta.Hoja"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        style="@style/Agro.Insignia"
                        android:backgroundTint="@color/sp_glicina_suave"
                        android:src="@drawable/ic_luna"
                        app:tint="@color/sp_glicina" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Agro.Texto.Seccion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Apariencia"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Modo día, modo noche o según el teléfono"
                            android:textColor="@color/sp_tinta_suave"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/grupoTema"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTemaClaro"
                        style="@style/Widget.Agro.Boton.Segmento"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Día"
                        app:icon="@drawable/ic_sol" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTemaNoche"
                        style="@style/Widget.Agro.Boton.Segmento"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Noche"
                        app:icon="@drawable/ic_luna" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTemaAuto"
                        style="@style/Widget.Agro.Boton.Segmento"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Auto"
                        app:icon="@drawable/ic_auto" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ================= UMBRALES ================= -->
        <TextView
            style="@style/Agro.Texto.Seccion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Umbrales del cultivo" />

        <!-- Nota explicativa -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_popup"
            android:backgroundTint="@color/sp_menta"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_hoja"
                app:tint="@color/sp_bosque" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:lineSpacingExtra="2dp"
                android:text="Cuando una lectura sale de estos rangos, AgroSaffer te avisa y guarda la alerta en el historial."
                android:textColor="@color/sp_bosque_oscuro"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- ================= CLIMA DEL AIRE ================= -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Agro.Tarjeta.Hoja"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        style="@style/Agro.Insignia"
                        android:backgroundTint="@color/sp_sol_suave"
                        android:src="@drawable/ic_termometro"
                        app:tint="@color/sp_sol_oscuro" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Agro.Texto.Seccion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Temperatura del aire"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Heladas y golpes de calor"
                            android:textColor="@color/sp_tinta_suave"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:hint="Mínima"
                        app:helperText="Helada"
                        app:placeholderText="2.0"
                        app:suffixText="°C">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etTempMin"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal|numberSigned"
                            android:textColor="@color/sp_tinta" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:hint="Máxima"
                        app:helperText="Golpe de calor"
                        app:placeholderText="35.0"
                        app:suffixText="°C">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etTempMax"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal|numberSigned"
                            android:textColor="@color/sp_tinta" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ================= VPD ================= -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Agro.Tarjeta.Hoja"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        style="@style/Agro.Insignia"
                        android:backgroundTint="@color/sp_menta"
                        android:src="@drawable/ic_hoja"
                        app:tint="@color/sp_bosque" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Agro.Texto.Seccion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Déficit de presión de vapor"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Zona óptima de transpiración (VPD)"
                            android:textColor="@color/sp_tinta_suave"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:hint="Mínimo"
                        app:helperText="Riesgo fúngico"
                        app:placeholderText="0.4"
                        app:suffixText="kPa">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etVpdMin"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:textColor="@color/sp_tinta" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:hint="Máximo"
                        app:helperText="Cierre estomático"
                        app:placeholderText="1.5"
                        app:suffixText="kPa">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etVpdMax"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:textColor="@color/sp_tinta" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ================= SUELO Y RAÍZ ================= -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Agro.Tarjeta.Hoja"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        style="@style/Agro.Insignia"
                        android:backgroundTint="@color/sp_terracota_suave"
                        android:src="@drawable/ic_brote"
                        app:tint="@color/sp_terracota" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Agro.Texto.Seccion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Suelo y metabolismo radicular"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Humedad y temperatura de raíz"
                            android:textColor="@color/sp_tinta_suave"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Humedad mínima a 15 cm"
                    app:helperText="Punto de marchitez"
                    app:placeholderText="20.0"
                    app:startIconDrawable="@drawable/ic_gota"
                    app:startIconTint="@color/sp_agua"
                    app:suffixText="%">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etHumSueloMin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:textColor="@color/sp_tinta" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:hint="Raíz mínima"
                        app:helperText="Bloqueo por frío"
                        app:placeholderText="12.0"
                        app:suffixText="°C">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etTempRadicularMin"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal|numberSigned"
                            android:textColor="@color/sp_tinta" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:hint="Raíz máxima"
                        app:helperText="Anoxia"
                        app:placeholderText="28.0"
                        app:suffixText="°C">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etTempRadicularMax"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal|numberSigned"
                            android:textColor="@color/sp_tinta" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ================= ACCIONES ================= -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardarConfig"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Guardar parámetros"
            app:icon="@drawable/ic_check" />

        <!-- ================= CUENTA (al final) ================= -->
        <TextView
            style="@style/Agro.Texto.Seccion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Cuenta" />

        <!-- Datos de la cuenta y sus opciones, todo a la vista -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Agro.Tarjeta.Hoja"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvInicialCuentaActual"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_circulo"
                        android:backgroundTint="@color/sp_marca"
                        android:fontFamily="serif"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:text="?"
                        android:textColor="@color/sp_sol"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvEmailCuentaActual"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="middle"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:text="Sin sesión"
                            android:textColor="@color/sp_tinta"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Sesión iniciada en este teléfono"
                            android:textColor="@color/sp_tinta_suave"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/sp_borde" />

                <LinearLayout
                    android:id="@+id/opcionCambiarCuenta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_cambiar_cuenta"
                        app:tint="@color/sp_tinta" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="Cambiar cuenta"
                        android:textColor="@color/sp_tinta"
                        android:textSize="15sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="56dp"
                    android:background="@color/sp_borde" />

                <LinearLayout
                    android:id="@+id/opcionCerrarSesion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_salir"
                        app:tint="@color/sp_terracota_oscuro" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="Cerrar sesión"
                        android:textColor="@color/sp_terracota_oscuro"
                        android:textSize="15sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="56dp"
                    android:background="@color/sp_borde" />

                <LinearLayout
                    android:id="@+id/opcionQuitarCuenta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_borrar"
                        app:tint="@color/sp_terracota_oscuro" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="Quitar cuenta del teléfono"
                        android:textColor="@color/sp_terracota_oscuro"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>

    <include layout="@layout/navegacion_inferior" />
</LinearLayout>
