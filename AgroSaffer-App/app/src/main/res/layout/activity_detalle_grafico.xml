<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <!-- ================= CABECERA ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Solo visible si se llegó tocando una tarjeta del panel -->
        <ImageView
            android:id="@+id/btnVolver"
            style="@style/Agro.BotonRedondo"
            android:layout_marginEnd="14dp"
            android:contentDescription="Volver"
            android:src="@drawable/ic_volver"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Título tocable: elige la variable a graficar -->
            <LinearLayout
                android:id="@+id/selectorVariable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:contentDescription="Elegir variable"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTituloGrafico"
                    style="@style/Agro.Texto.TituloPantalla"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tendencias"
                    android:textSize="22sp" />

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="2dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_expandir"
                    app:tint="@color/sp_bosque" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Selector de nodo: chip con círculo de estado, igual que en Inicio -->
                <Spinner
                    android:id="@+id/spinnerNodoGrafico"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_pastilla"
                    android:backgroundTint="@color/sp_menta"
                    android:contentDescription="Elegir nodo"
                    android:dropDownVerticalOffset="8dp"
                    android:dropDownWidth="300dp"
                    android:minHeight="44dp"
                    android:popupBackground="@drawable/bg_popup"
                    android:spinnerMode="dropdown"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Solo mediciones confirmadas"
                    android:textColor="@color/sp_tinta_suave"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ================= RANGO DE TIEMPO ================= -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:clipToPadding="false"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipsRango"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:checkedChip="@+id/chip24h"
            app:chipSpacingHorizontal="8dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip1h"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 h" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip6h"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6 h" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip24h"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="24 h" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip7d"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7 días" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip30d"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30 días" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip6m"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6 meses" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip1a"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 año" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- ================= MÉTRICAS ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <!-- Actual -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Agro.Tarjeta.Hero"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1.3">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_degradado_bosque"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    style="@style/Agro.Texto.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Actual"
                    android:textColor="@color/sp_sobre_bosque_suave"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvValorActual"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:text="--"
                    android:textColor="@color/sp_sobre_bosque"
                    app:autoSizeMaxTextSize="20sp"
                    app:autoSizeMinTextSize="11sp"
                    app:autoSizeTextType="uniform" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Promedio -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    style="@style/Agro.Texto.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Promedio"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvPromedio"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:text="--"
                    android:textColor="@color/sp_tinta"
                    app:autoSizeMaxTextSize="16sp"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeTextType="uniform" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Rango -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1.2">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    style="@style/Agro.Texto.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mín – Máx"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvRango"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:text="--"
                    android:textColor="@color/sp_tinta"
                    app:autoSizeMaxTextSize="15sp"
                    app:autoSizeMinTextSize="9sp"
                    app:autoSizeTextType="uniform" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- ================= GRÁFICO ================= -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Agro.Tarjeta.Hoja"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="16dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Deslizá o pellizcá para explorar"
                android:textColor="@color/sp_tinta_tenue"
                android:textSize="11sp" />

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/lineChart"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="6dp"
                android:layout_weight="1" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>

    <include layout="@layout/navegacion_inferior" />
</LinearLayout>
