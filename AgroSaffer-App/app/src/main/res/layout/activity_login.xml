<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_amanecer"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- PAISAJE SOLARPUNK -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/ill_paisaje_solarpunk" />

        <!-- PANEL DE ACCESO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="-24dp"
            android:background="@drawable/bg_panel_superior"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="28dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    style="@style/Agro.Insignia"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="11dp"
                    android:backgroundTint="@color/sp_marca"
                    android:src="@drawable/ic_hoja"
                    app:tint="@color/sp_sol" />

                <TextView
                    style="@style/Agro.Texto.Marca"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="@string/app_name"
                    android:textSize="30sp" />
            </LinearLayout>

            <TextView
                style="@style/Agro.Texto.Cuerpo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Telemetría viva para cultivos que crecen con el sol."
                android:textSize="16sp" />

            <!-- ========== MODO 1: CUENTAS GUARDADAS ========== -->
            <LinearLayout
                android:id="@+id/layoutCuentas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Agro.Texto.Seccion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Elegí una cuenta"
                    android:textSize="17sp" />

                <LinearLayout
                    android:id="@+id/contenedorCuentas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOtraCuenta"
                    style="@style/Widget.Agro.Boton.Contorno"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Usar otra cuenta"
                    app:icon="@drawable/ic_persona_agregar" />
            </LinearLayout>

            <!-- ========== MODO 2: FORMULARIO ========== -->
            <LinearLayout
                android:id="@+id/layoutFormulario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTituloFormulario"
                    style="@style/Agro.Texto.Seccion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Iniciá sesión"
                    android:textSize="17sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Correo electrónico"
                    app:startIconDrawable="@drawable/ic_correo">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="emailAddress"
                        android:imeOptions="actionNext"
                        android:inputType="textEmailAddress"
                        android:textColor="@color/sp_tinta" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="Contraseña"
                    app:endIconMode="password_toggle"
                    app:startIconDrawable="@drawable/ic_candado">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="password"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:textColor="@color/sp_tinta" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="Entrar al campo"
                    app:icon="@drawable/ic_hoja"
                    app:iconTint="@color/sp_acento_boton" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVerCuentas"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Elegir una cuenta guardada"
                    android:textAllCaps="false"
                    android:visibility="gone" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:drawablePadding="6dp"
                android:gravity="center"
                android:text="☀  Monitoreo agronómico sostenible"
                android:textColor="@color/sp_tinta_tenue"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
