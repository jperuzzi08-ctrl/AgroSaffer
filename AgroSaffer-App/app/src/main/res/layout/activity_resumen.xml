<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- ================= CABECERA ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Agro.Texto.TituloPantalla"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tu campo" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Todos los nodos en un vistazo"
                        android:textColor="@color/sp_tinta_suave"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnExportarResumen"
                    style="@style/Agro.BotonRedondo"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="Exportar todos los datos a Excel"
                    android:src="@drawable/ic_exportar" />

                <ImageView
                    android:id="@+id/btnModoTemaResumen"
                    style="@style/Agro.BotonRedondo"
                    android:contentDescription="Cambiar entre modo día y noche"
                    android:src="@drawable/ic_modo_tema" />
            </LinearLayout>

            <!-- ================= TARJETA PRINCIPAL ================= -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Agro.Tarjeta.Hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_degradado_bosque"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        style="@style/Agro.Texto.Overline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Resumen del campo"
                        android:textColor="@color/sp_sobre_bosque_suave" />

                    <TextView
                        android:id="@+id/tvCantidadNodos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="serif"
                        android:text="Cargando nodos…"
                        android:textColor="@color/sp_sobre_bosque"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvResumenEstados"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Esperando los datos del servidor"
                        android:textColor="@color/sp_sobre_bosque_suave"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvNodosEnLinea"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pastilla"
                            android:backgroundTint="@color/sp_menta"
                            android:fontFamily="sans-serif-medium"
                            android:paddingStart="10dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="5dp"
                            android:text="0 en línea"
                            android:textColor="@color/sp_bosque_oscuro"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvNodosConProblema"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_pastilla"
                            android:backgroundTint="@color/sp_terracota_suave"
                            android:fontFamily="sans-serif-medium"
                            android:paddingStart="10dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="5dp"
                            android:text="Sin problemas"
                            android:textColor="@color/sp_terracota_oscuro"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ================= LISTA DE NODOS ================= -->
            <LinearLayout
                android:id="@+id/contenedorNodos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/layoutVacioResumen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_circulo"
                    android:backgroundTint="@color/sp_menta"
                    android:importantForAccessibility="no"
                    android:padding="16dp"
                    android:src="@drawable/ic_brote"
                    app:tint="@color/sp_bosque" />

                <TextView
                    style="@style/Agro.Texto.Seccion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:text="Todavía no hay nodos" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="Cuando un nodo envíe datos, va a aparecer acá con su estado y sus últimas mediciones."
                    android:textColor="@color/sp_tinta_suave"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/navegacion_inferior" />
</LinearLayout>
