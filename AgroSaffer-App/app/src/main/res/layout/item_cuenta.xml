<?xml version="1.0" encoding="utf-8"?>
<!-- Cuenta guardada en el inicio de sesión: avatar, correo, último uso y botón para quitarla -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tarjetaCuenta"
    style="@style/Widget.Agro.Tarjeta.Hoja"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="68dp"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="4dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tvInicialCuenta"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circulo"
            android:backgroundTint="@color/sp_menta"
            android:fontFamily="serif"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textColor="@color/sp_bosque"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEmailCuenta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/sp_tinta"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvUltimoUsoCuenta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:textColor="@color/sp_tinta_suave"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnQuitarCuenta"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Quitar cuenta guardada"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_cerrar"
            app:tint="@color/sp_tinta_tenue" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
