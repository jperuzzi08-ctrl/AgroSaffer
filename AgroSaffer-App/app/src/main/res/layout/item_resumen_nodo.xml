<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardNodoResumen"
    style="@style/Widget.Agro.Tarjeta.Hoja"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ================= NOMBRE Y ESTADO ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <View
                android:id="@+id/puntoEstadoResumen"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_punto_estado"
                android:backgroundTint="@color/sp_tinta_tenue" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvNombreNodoResumen"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="Nodo"
                        android:textColor="@color/sp_tinta"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/tvBadgeProblema"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_circulo"
                        android:backgroundTint="@color/sp_terracota"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:text="!"
                        android:textColor="@color/sp_crema"
                        android:textSize="15sp"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvSubtituloNodoResumen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Subtítulo"
                    android:textColor="@color/sp_bosque"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvEstadoNodoResumen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Sin datos"
                    android:textColor="@color/sp_tinta_suave"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnEditarSubtituloResumen"
                style="@style/Agro.BotonRedondo"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:contentDescription="Editar subtítulo del nodo"
                android:padding="9dp"
                android:src="@drawable/ic_editar"
                app:tint="@color/sp_tinta_suave" />
        </LinearLayout>

        <!-- ================= MÉTRICAS ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Agro.Texto.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VPD · kPa"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/tvVpdResumen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="--"
                    android:textColor="@color/sp_tinta"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Agro.Texto.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AIRE · °C"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/tvTempAireResumen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="--"
                    android:textColor="@color/sp_tinta"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Agro.Texto.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HUM. AIRE · %"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/tvHumAireResumen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="--"
                    android:textColor="@color/sp_tinta"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Agro.Texto.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SUELO 15 · %"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/tvHum15Resumen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="--"
                    android:textColor="@color/sp_tinta"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Agro.Texto.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SUELO 40 · %"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/tvHum40Resumen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="--"
                    android:textColor="@color/sp_tinta"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Agro.Texto.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SUELO · °C"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/tvTempSueloResumen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="--"
                    android:textColor="@color/sp_tinta"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ================= PIE ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvBateriaResumen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Batería --"
                android:textColor="@color/sp_tinta_suave"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvPresionResumen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="-- hPa"
                android:textColor="@color/sp_tinta_suave"
                android:textSize="11sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvAlertasResumen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Sin alertas"
                android:textColor="@color/sp_tinta_suave"
                android:textSize="11sp" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="2dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron"
                app:tint="@color/sp_tinta_suave" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
