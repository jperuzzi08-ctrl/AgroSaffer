<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_marker_pill"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="8dp"
    android:paddingEnd="14dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/tvMarkerTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="16:56:32"
        android:textColor="@color/sp_sobre_bosque_suave"
        android:textSize="12sp" />

    <View
        android:layout_width="5dp"
        android:layout_height="5dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_circulo"
        android:backgroundTint="@color/sp_sol" />

    <TextView
        android:id="@+id/tvMarkerValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="125"
        android:textColor="@color/sp_sobre_bosque"
        android:textSize="13sp" />
</LinearLayout>
